# 비밀값과 연결 정보만 둔다. 모델·추론 수준·시간 제한은 app/core/config.py 상수다.
# 발송 여부는 사용자별 발송 설정(미설정/승인 필요/자동 발송)과 Gmail 발송 권한이 정한다. 서버 스위치는 없다.
# 값이 비어 있으면 서버는 항목 이름만 경고하고, 그 값이 필요한 워커만 꺼진 채 API는 계속 동작한다.
# 여기 없는 이름은 코드가 읽지 않는다. 워커·발송을 끄는 환경변수는 없다(README "환경변수와 긴급 정지").
# 이름을 더하거나 뺀 뒤에는: python -m unittest scripts.check_env_names
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Chat Completions/Responses 호환 endpoint (예: 승인된 제공자의 /v1 base URL)
LLM_BASE_URL=
LLM_API_KEY=

# 로그인 연결 메일함. Supabase Google 로그인과 같은 OAuth 클라이언트
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 한 번 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 서버 비밀 금고에만 보관한다. Git이나 Supabase 테이블에 넣지 않는다.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# JSON 배열. 실제 Flutter 웹 origin
CORS_ORIGINS=["http://localhost:3000"]

# 프록시 헤더(X-Forwarded-Proto)를 믿을 프록시 주소(IP·CIDR, 쉼표 구분). uvicorn이 읽는다.
# 로컬·compose는 127.0.0.1(이미지 기본값과 같다). Lightsail은 로드밸런서 사설 대역 172.26.0.0/16.
# 프록시와 맞지 않으면 계정 연결이 HTTPS_REQUIRED로 거절된다. 포트가 직접 열린 서버에서 * 는 쓰지 않는다.
FORWARDED_ALLOW_IPS=127.0.0.1

# 선택: Pub/Sub 푸시. 네 값이 모두 있을 때만 watch를 요청하고, 없으면 폴링한다.
GMAIL_TOPIC=
GMAIL_SUBSCRIPTION=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# 에이전트 실행 기록(LangSmith, US 지역). 키가 있으면 기록하고, 비우면 기록하지 않는다.
# 업무 ID(case_id)·환경(environment) 메타데이터로 실행을 검색할 수 있다.
# 키: smith.langchain.com → Settings → API Keys → Service Key (lsv2_sk_...). 팀 비밀 금고에만 보관한다.
LANGSMITH_API_KEY=
# 기록할 프로젝트 이름. 없으면 첫 기록 때 자동으로 생긴다. 운영은 gyeonjwo-prod로 나눈다
LANGSMITH_PROJECT=gyeonjwo-dev
# Service Key는 작업 공간 ID가 있어야 한다(없으면 403). Settings → Workspaces에서 확인한다. 비밀값 아님
LANGSMITH_WORKSPACE_ID=
# 기록의 입력·출력 내용(메일 원문·업체명·단가)을 가린다. 기본 true(운영은 반드시 true).
# 합성 데이터로 개발할 때만 false로 두면 프롬프트·도구 결과까지 볼 수 있다
LANGSMITH_HIDE_CONTENT=true
# 실행 환경 이름(기록 metadata environment). 운영은 production
APP_ENVIRONMENT=development

# 선택: 로그 수준(기본 INFO), PDF 워커 메모리 상한 MB(기본 760)
LOG_LEVEL=INFO
PDF_WORKER_MEMORY_MB=760
