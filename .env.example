SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Team-selected model; no model/vendor is selected automatically.
# Chat Completions compatible endpoint, e.g. an approved provider's /v1 base URL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CLASSIFICATION_MODEL=
# 에이전트 역할별 모델 (비우면 LLM_MODEL)
LLM_MODEL_INFO_EXTRACTOR=
LLM_MODEL_CANDIDATE=
LLM_MODEL_INFO_PRIORITY=
LLM_MODEL_RESPONSE_PLAN=
LLM_MODEL_COUNTER_OFFER=
# 에이전트 추론 수준 (OpenAI reasoning effort). 비우면 보내지 않음(모델 기본값). 역할별 값이 비면 LLM_REASONING_EFFORT
# 값: none / minimal / low / medium / high / xhigh / max. 모델마다 받는 값과 기본값이 다름 (2026-11-02 OpenAI 문서)
#   gpt-5.4-mini: none(기본) / low / medium / high / xhigh  (minimal·max 없음)
#   gpt-6.1-sol: none·minimal 없음, 기본 medium / gpt-6 sol·gpt-6 luna·gpt-5.5·gpt-5.6: 기본 medium / gpt-6 astra: none 없음
#   받지 않는 값을 넣으면 API가 400 오류를 낸다. 그 밖의 모델은 OpenAI 모델 페이지에서 확인
LLM_REASONING_EFFORT=
LLM_REASONING_EFFORT_INFO_EXTRACTOR=
LLM_REASONING_EFFORT_CANDIDATE=
LLM_REASONING_EFFORT_INFO_PRIORITY=
LLM_REASONING_EFFORT_RESPONSE_PLAN=
LLM_REASONING_EFFORT_COUNTER_OFFER=
# Classification only. Empty sends no reasoning_effort. Change it together with the model:
# gpt-5-nano accepts minimal, gpt-5.4-nano and Luna models accept none. A wrong value fails every classification.
LLM_CLASSIFICATION_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
ANALYSIS_TIMEOUT_SECONDS=600
CALCULATION_ROUNDS=3

# JSON array. Set to the actual Flutter web origin(s).
CORS_ORIGINS=["http://localhost:3000"]

# One authorized demo mailbox per server process. Gmail readonly OAuth scope.
GMAIL_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOPIC=
GMAIL_SUBSCRIPTION=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# Enable after the DB, Gmail OAuth and Pub/Sub project are configured.
WORKER_ENABLED=false
WORKER_POLL_SECONDS=10
WORKER_SYNC_SECONDS=300

# Login-connected Google mailboxes. Same OAuth client as Supabase Google login.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the generated key in server secrets, not in Git or Supabase tables.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Enable only after DB teammate implements the RPC contract and classifier is connected.
# Keep legacy WORKER_ENABLED=false when this is true.
GOOGLE_MAILBOX_WORKER_ENABLED=false
GOOGLE_MAILBOX_POLL_SECONDS=90
# Initial inbox import and expired-history recovery only; new-mail history is not capped.
# Set on the PC actually running the backend, then restart its worker.
GMAIL_INITIAL_SYNC_LIMIT=10

# Extraction only. No ②–⑤ execution is enabled by this card.
AGENT_STOP_AFTER_EXTRACTION=true
# Enable only after the DB owner's graph contract is ready. The graph itself
# has no extraction-only stop option; START runs through candidate/RFQ drafting.
AGENT_GRAPH_ENABLED=false
AGENT_GRAPH_TIMEOUT_SECONDS=180
AGENT_GRAPH_REQUEST_TIMEOUT_SECONDS=45
# Enable on the API host after existing Supabase runtime functions and LLM settings are verified.
AGENT_EXTRACTION_ENABLED=false
# Run on the same API server, one server only. A live worker is required to expose START.
# Both AGENT_EXTRACTION_ENABLED and AGENT_EXTRACTION_WORKER_ENABLED must be true for review execution.
AGENT_EXTRACTION_WORKER_ENABLED=false

# Enable after SQL v3.6 deployment. Server-side mailbox owner UUID allowlist.
# Header retrieval needs Gmail read scope. Never performs mail sending.
RFQ_METADATA_WORKER_ENABLED=false
RFQ_METADATA_OWNER_IDS=[]

# ② server pipeline. Enable only after full v3.6 schema, supplier data and policies.
# One workflow server. No production send is enabled by these example defaults.
RFQ_WORKFLOW_ENABLED=false
RFQ_WORKFLOW_OWNER_IDS=[]
# Requires configured send policy and SQL claim authorized=true for every draft.
RFQ_MAIL_SENDING_ENABLED=false

# Pub/Sub is optional for polling. A watch is only requested when all four push settings exist.
# Run python -m scripts.check_integration --local-only to check names/formats without displaying keys.
# A development HTTPS tunnel is optional: compose.https.yaml, started explicitly with -Publish.

# Later graph stages: keep disabled until graph_review.json RPC contracts are deployed.
AGENT_GRAPH_REVIEW_ENABLED=false
AGENT_GRAPH_REVIEW_TIMEOUT_SECONDS=300

# KAN-98 supplier crawling trial (python -m scripts.crawl_trial). Keys stay in .env only.
# 식품안전나라 Open API key: 품목제조보고(I1250)·식품제조가공업(I1220)
FOOD_SAFETY_API_KEY=
# 공공데이터포털 key: 한국식품안전관리인증원 식품 제조가공 HACCP 업체 정보
DATA_GO_KR_SERVICE_KEY=
HACCP_API_URL=https://apis.data.go.kr/B553748/FoodCompanyListService/getFoodCompanyList
# NAVER API HUB (Naver Cloud) Application with Webkr(+Local) search: finds supplier homepages. Without it, use --seeds.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
CRAWL_USER_AGENT=GyeonjwoSupplierTrial/0.1
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_PAGES_PER_SITE=4
