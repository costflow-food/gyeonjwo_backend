SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Team-selected model; no model/vendor is selected automatically.
# Chat Completions compatible endpoint, e.g. an approved provider's /v1 base URL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CLASSIFICATION_MODEL=
LLM_TIMEOUT_SECONDS=60
ANALYSIS_TIMEOUT_SECONDS=600
CALCULATION_ROUNDS=3

# JSON array. Set to the actual Flutter web origin(s).
CORS_ORIGINS=[]

# One authorized demo mailbox per server process. Gmail readonly OAuth scope.
GMAIL_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOPIC=
GMAIL_SUBSCRIPTION=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# Enable after the DB, Gmail OAuth and Pub/Sub project are configured.
WORKER_ENABLED=false
WORKER_POLL_SECONDS=10
WORKER_SYNC_SECONDS=300
