  "components": {
    "schemas": {
      "AnalyzeOut": {
        "properties": {
          "saved_fields": {
            "type": "integer",
            "title": "Saved Fields"
          },
          "lines": {
            "type": "integer",
            "title": "Lines"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ExtractedField"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "saved_fields",
          "lines",
          "warnings",
          "fields"
        ],
        "title": "AnalyzeOut"
      },
      "AnalyzeRequest": {
        "properties": {
          "file_ids": {
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}\\.(pdf|eml|txt)$"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "File Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_ids"
        ],
        "title": "AnalyzeRequest"
      },
      "Body_upload_api_v1_work_items__work_id__files_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_work_items__work_id__files_post"
      },
      "DecisionOut": {
        "properties": {
          "work_id": {
            "type": "string",
            "title": "Work Id"
          },
          "line_no": {
            "type": "integer",
            "title": "Line No"
          },
          "reference_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "work_id",
          "line_no",
          "reference_id",
          "summary"
        ],
        "title": "DecisionOut"
      },
      "DecisionRequest": {
        "properties": {
          "line_no": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Line No"
          },
          "reference_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Id"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Summary"
          },
          "comparison_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Comparison Confirmed"
          },
          "comparison_note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "pattern": "\\S",
            "title": "Comparison Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "line_no",
          "summary",
          "comparison_confirmed",
          "comparison_note"
        ],
        "title": "DecisionRequest"
      },
      "ExtractedField": {
        "properties": {
          "line_no": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
