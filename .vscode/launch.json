{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CostFlow API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["costflow.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {"PYTHONPATH": "${workspaceFolder}/src"},
      "justMyCode": true
    }
  ]
}

